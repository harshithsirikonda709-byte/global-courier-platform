DATABASE_URL=sqlite:///./carecircle.db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# ES256/RS256 use the project's published JWKS keys from {SUPABASE_URL}/auth/v1/.well-known/jwks.json.
SUPABASE_JWT_ALGORITHM=ES256
# Required only if SUPABASE_JWT_ALGORITHM is HS256 (or AUTO with HS256 tokens).
SUPABASE_JWT_SECRET=replace-with-your-jwt-secret
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development
# Comma-separated Supabase Auth user IDs allowed to access admin-only endpoints.
ADMIN_USER_IDS=
