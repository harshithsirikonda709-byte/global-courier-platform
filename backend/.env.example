# Obtain these values from Supabase Dashboard > Project Settings > API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# JWT signing algorithm: ES256 (default for new Supabase projects), RS256, HS256, or AUTO.
# ES256 and RS256 use the project's published JWKS keys from {SUPABASE_URL}/auth/v1/.well-known/jwks.json.
# HS256 requires SUPABASE_JWT_SECRET.
SUPABASE_JWT_ALGORITHM=ES256

# Required only if SUPABASE_JWT_ALGORITHM is HS256 (or AUTO with HS256 tokens).
# Never commit the real secret.
SUPABASE_JWT_SECRET=replace-with-your-jwt-secret

ENVIRONMENT=development

# Configurable CORS allowed origins: supports JSON array format or comma-separated strings.
# Examples:
# CORS_ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
# CORS_ALLOWED_ORIGINS=http://localhost:3000, http://localhost:5173
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
