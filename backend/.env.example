# Obtain these values from Supabase Dashboard > Project Settings > API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# The JWT secret is only needed when validating HS256 Supabase tokens locally.
# Do not commit the real value.
SUPABASE_JWT_SECRET=replace-with-your-jwt-secret
ENVIRONMENT=development

